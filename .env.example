# Copy to .env (git-ignored) and fill in. The API server loads it on start.
# Without BREVO_API_KEY, emails are printed to the server console instead (non-production only).

# Brevo (formerly Sendinblue) transactional email: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Must be a sender you have verified in Brevo (Senders, domains & dedicated IPs).
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Fellowship

# Public URL of the web client; used to build the magic links in emails.
APP_URL=http://localhost:5173
